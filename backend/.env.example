# Local development can use SQLite. Production must use PostgreSQL, for
# example: postgresql+psycopg://USER:PASSWORD@HOST:5432/vetty
DATABASE_URL=sqlite:///vetty.db
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Comma-separated client origins when the frontend is hosted separately.
# Leave unset for local development, where Vite proxies /api requests.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production bootstrap only. Set both values in the deployed backend's
# environment to create the first admin account once; never commit real values.
# The account is not reset or overwritten after it exists.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_USERNAME=vetty-admin

# Stripe: use test keys during development.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=kes

# Safaricom Daraja STK Push sandbox configuration.
# Use `production` only with your live Daraja app credentials and a live shortcode.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=replace_me
MPESA_CONSUMER_SECRET=replace_me
MPESA_SHORTCODE=174379
MPESA_PASSKEY=replace_me
MPESA_QUERY_URL=https://sandbox.safaricom.co.ke/mpesa/stkpushquery/v1/query
# This must be a public HTTPS address. Keep the token value identical to
# MPESA_CALLBACK_TOKEN; it authenticates callbacks routed through the URL.
MPESA_CALLBACK_URL=https://your-public-domain.example/api/payments/mpesa/callback?token=replace_me
MPESA_CALLBACK_TOKEN=replace_me
# Optional: only needed when the payment API runs on a port other than 5000.
MPESA_LOCAL_CALLBACK_URL=http://127.0.0.1:5000/api/payments/mpesa/callback
