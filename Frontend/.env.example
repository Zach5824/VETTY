# The dev server proxies /api to this address. Change only when Flask runs on
# a non-default port.
VITE_API_PROXY_TARGET=http://127.0.0.1:5000

# For a separately deployed backend, set its full public origin. When this is
# unset, the app uses the same-origin /api path (the Vite proxy in development).
# VITE_API_URL=https://api.example.com
